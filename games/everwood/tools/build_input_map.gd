## Writes the player controls into project.godot's [input] section, so the
## bindings live in the Input Map (Project Settings > Input Map) without anyone
## hand-editing the serialized event lines. Every action listens on all devices;
## each player's InputComponent reads only its own device (keyboard and mouse,
## or one pad). Re-run after changing a binding here:
##   godot --headless --path . --script res://tools/build_input_map.gd
extends SceneTree

const PROJECT_FILE: String = "res://project.godot"
const BUTTON_DEADZONE: float = 0.5
const STICK_DEADZONE: float = 0.2


func _initialize() -> void:
	var sections: PackedStringArray = PackedStringArray()
	sections.append("[input]\n")
	sections.append("; Generated by tools/build_input_map.gd. Change bindings there and re-run it.\n")
	var bindings: Dictionary[StringName, Array] = _bindings()
	for action: StringName in bindings:
		var deadzone: float = _deadzone_for(action)
		var events: Array = bindings[action]
		sections.append("%s=%s\n" % [action, var_to_str({"deadzone": deadzone, "events": events})])
	var input_section: String = "\n".join(sections)

	var text: String = FileAccess.get_file_as_string(PROJECT_FILE)
	var start: int = text.find("\n[input]\n")
	if start >= 0:
		var end: int = text.find("\n[", start + 1)
		text = text.substr(0, start + 1) + input_section + "\n" + (text.substr(end + 1) if end >= 0 else "")
	else:
		var anchor: int = text.find("\n[layer_names]\n")
		text = text.substr(0, anchor + 1) + input_section + "\n" + text.substr(anchor + 1)
	var file: FileAccess = FileAccess.open(PROJECT_FILE, FileAccess.WRITE)
	file.store_string(text)
	file.close()
	print("build_input_map: wrote %d actions to %s" % [bindings.size(), PROJECT_FILE])
	quit(0)


## Keyboard and mouse is Player 1; every pad uses the same pad bindings.
## Pad buttons are named by position (Godot's X is the left face button:
## Square on PlayStation, X on Xbox).
func _bindings() -> Dictionary[StringName, Array]:
	var map: Dictionary[StringName, Array] = {}
	map[InputComponent.ACTION_MOVE_LEFT] = [_key(KEY_A), _axis(JOY_AXIS_LEFT_X, -1.0)]
	map[InputComponent.ACTION_MOVE_RIGHT] = [_key(KEY_D), _axis(JOY_AXIS_LEFT_X, 1.0)]
	map[InputComponent.ACTION_MOVE_FORWARD] = [_key(KEY_W), _axis(JOY_AXIS_LEFT_Y, -1.0)]
	map[InputComponent.ACTION_MOVE_BACK] = [_key(KEY_S), _axis(JOY_AXIS_LEFT_Y, 1.0)]
	map[InputComponent.ACTION_CAMERA_LEFT] = [_key(KEY_LEFT), _axis(JOY_AXIS_RIGHT_X, -1.0)]
	map[InputComponent.ACTION_CAMERA_RIGHT] = [_key(KEY_RIGHT), _axis(JOY_AXIS_RIGHT_X, 1.0)]
	# Camera pitch (18 GDD §6): the right stick's Y, PageUp / [ to look up and PageDown / ] to look down.
	map[InputComponent.ACTION_CAMERA_PITCH_UP] = [_key(KEY_PAGEUP), _key(KEY_BRACKETLEFT), _axis(JOY_AXIS_RIGHT_Y, -1.0)]
	map[InputComponent.ACTION_CAMERA_PITCH_DOWN] = [_key(KEY_PAGEDOWN), _key(KEY_BRACKETRIGHT), _axis(JOY_AXIS_RIGHT_Y, 1.0)]
	map[InputComponent.ACTION_MOUSE_LOOK] = [_key(KEY_V)]
	map[InputComponent.ACTION_LIGHT] = [_key(KEY_J), _mouse(MOUSE_BUTTON_LEFT), _button(JOY_BUTTON_X)]
	map[InputComponent.ACTION_HEAVY] = [_key(KEY_K), _mouse(MOUSE_BUTTON_RIGHT), _button(JOY_BUTTON_Y)]
	# Phase 12 Kaizen (K1): jump on ✕ / A, roll on ○ / B, sprint on L3 / LS (held while moving).
	map[InputComponent.ACTION_JUMP] = [_key(KEY_SPACE), _button(JOY_BUTTON_A)]
	map[InputComponent.ACTION_DODGE] = [_key(KEY_L), _button(JOY_BUTTON_B)]
	map[InputComponent.ACTION_SPRINT] = [_key(KEY_SHIFT), _button(JOY_BUTTON_LEFT_STICK)]
	map[InputComponent.ACTION_TRIGGER_L] = [_key(KEY_Q), _axis(JOY_AXIS_TRIGGER_LEFT, 1.0), _button(JOY_BUTTON_LEFT_SHOULDER)]
	map[InputComponent.ACTION_TRIGGER_R] = [_key(KEY_E), _axis(JOY_AXIS_TRIGGER_RIGHT, 1.0), _button(JOY_BUTTON_RIGHT_SHOULDER)]
	map[InputComponent.ACTION_ULT] = [_key(KEY_R)]
	map[InputComponent.ACTION_TETHER_UP] = [_key(KEY_1), _button(JOY_BUTTON_DPAD_UP)]
	map[InputComponent.ACTION_TETHER_RIGHT] = [_key(KEY_2), _button(JOY_BUTTON_DPAD_RIGHT)]
	map[InputComponent.ACTION_TETHER_DOWN] = [_key(KEY_3), _button(JOY_BUTTON_DPAD_DOWN)]
	map[InputComponent.ACTION_TETHER_LEFT] = [_key(KEY_4), _button(JOY_BUTTON_DPAD_LEFT)]
	map[InputComponent.ACTION_CHANGE_CLASS] = [_key(KEY_TAB), _button(JOY_BUTTON_BACK)]
	map[InputComponent.ACTION_CHANGE_MODE] = [_key(KEY_M), _button(JOY_BUTTON_RIGHT_STICK)]
	# L3 sprints now: on a pad the Calling is changed at the Calling Tutor, the Scribe Desk or the Grimoire.
	map[InputComponent.ACTION_CHANGE_CALLING] = [_key(KEY_C)]
	# The playtest switcher (K2): F2; on a pad, hold Share and tap the D-Pad (read in InputComponent).
	map[InputComponent.ACTION_PLAYTEST_CYCLE] = [_key(KEY_F2)]
	map[InputComponent.ACTION_JOIN] = [_key(KEY_ENTER), _button(JOY_BUTTON_START)]
	# The Options menu (13_PLAYTEST §2.1): Esc, or a tap of a seated pad's Options / Menu; holding Start still leaves.
	map[InputComponent.ACTION_OPTIONS] = [_key(KEY_ESCAPE), _button(JOY_BUTTON_START)]
	# The Developer Tools (13_PLAYTEST §2.13): F1; on a pad, hold Share and tap D-Pad ↑ (read in InputComponent).
	map[InputComponent.ACTION_DEV_TOOLS] = [_key(KEY_F1)]
	# The quest book: B on the keyboard (on a pad, Share held and D-Pad ↓, read in InputComponent).
	map[InputComponent.ACTION_QUEST_BOOK] = [_key(KEY_B)]
	return map


func _is_stick(action: StringName) -> bool:
	return action in [InputComponent.ACTION_MOVE_LEFT, InputComponent.ACTION_MOVE_RIGHT, InputComponent.ACTION_MOVE_FORWARD,
		InputComponent.ACTION_MOVE_BACK, InputComponent.ACTION_CAMERA_LEFT, InputComponent.ACTION_CAMERA_RIGHT]


## The right stick's Y has its own, finer deadzone (18 GDD §6: 0.15).
func _deadzone_for(action: StringName) -> float:
	if action in [InputComponent.ACTION_CAMERA_PITCH_UP, InputComponent.ACTION_CAMERA_PITCH_DOWN]:
		return InputComponent.PITCH_STICK_DEADZONE
	return STICK_DEADZONE if _is_stick(action) else BUTTON_DEADZONE


func _key(physical: Key) -> InputEventKey:
	var event: InputEventKey = InputEventKey.new()
	event.device = -1
	event.physical_keycode = physical
	return event


func _mouse(button: MouseButton) -> InputEventMouseButton:
	var event: InputEventMouseButton = InputEventMouseButton.new()
	event.device = -1
	event.button_index = button
	return event


func _button(button: JoyButton) -> InputEventJoypadButton:
	var event: InputEventJoypadButton = InputEventJoypadButton.new()
	event.device = -1
	event.button_index = button
	return event


func _axis(axis: JoyAxis, direction: float) -> InputEventJoypadMotion:
	var event: InputEventJoypadMotion = InputEventJoypadMotion.new()
	event.device = -1
	event.axis = axis
	event.axis_value = direction
	return event
