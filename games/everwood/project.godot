; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Everwood"
config/description="A cooperative raid action-RPG for a family party: up to 4 on the couch, 5 across the network."
run/main_scene="res://src/levels/hub_town.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

; Scripts reach these through their class's static `current` (NetworkManager.current,
; CombatDirector.current, InstanceManager.current, AudioCues.current,
; PartyProgress.current, ArsenalCatalog.current), so the keys differ from the
; class names. The Arsenal comes first: the others look card and item ids up in it.
Arsenal="*res://src/actors/arsenal_catalog.gd"
Network="*res://src/autoloads/network_manager.gd"
Instance="*res://src/autoloads/instance_manager.gd"
Combat="*res://src/autoloads/combat_director.gd"
Audio="*res://src/autoloads/audio_cues.gd"
Progress="*res://src/autoloads/party_progress.gd"

[debug]

; The engineering contract makes static typing mandatory, so an untyped
; variable, parameter or return value is a build error, not a warning.
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

