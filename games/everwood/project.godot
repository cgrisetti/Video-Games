; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Everwood"
config/description="A cooperative raid action-RPG for a family party: up to 4 on the couch, 5 across the network."
run/main_scene="res://scenes/worlds/caldera_isles.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Arsenal="*res://src/actors/arsenal_catalog.gd"
Network="*res://src/autoloads/network_manager.gd"
Instance="*res://src/autoloads/instance_manager.gd"
Combat="*res://src/autoloads/combat_director.gd"
Audio="*res://src/autoloads/audio_cues.gd"
Score="*res://src/core/audio_director.gd"
Atmosphere="*res://src/world/world_atmosphere_director.gd"
Progress="*res://src/autoloads/party_progress.gd"
Caldera="*res://src/world/caldera/caldera_world_state.gd"
Settings="*res://src/autoloads/settings_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

