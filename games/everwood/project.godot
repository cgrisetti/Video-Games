; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Everwood"
config/description="A cooperative raid action-RPG for a family party: up to 4 on the couch, 5 across the network."
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

; Scripts reach these through NetworkManager.current and CombatDirector.current
; (static), so the keys differ from the class names.
Network="*res://src/autoloads/network_manager.gd"
Combat="*res://src/autoloads/combat_director.gd"

[debug]

; The engineering contract makes static typing mandatory, so an untyped
; variable, parameter or return value is a build error, not a warning.
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Boss"
3d_physics/layer_4="PlayerHurtboxes"
3d_physics/layer_5="BossHurtboxes"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
