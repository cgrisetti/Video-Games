## Oakshire Vale (12_WORLD_OAKSHIRE_VALE_GDD.md, 13_STARTING_ZONE_ENCOUNTER_DESIGN.md):
## the starting zone as one streamed world of 12 x 12 Landblocks, through the
## same WorldGridManager as Dover-Slap-Falls world (OakshireValeLayout tells it the
## vale's shape). The party arrives at Wayfarer-Green in the south petal and
## walks up over the Bridge-Warden's span into Oakshire-Wick.
##
## The level wires up what streams in: wild creatures' spawners grow their
## packs, quest givers show their quests on the asker's screen, vendors open
## the Armory & Scribe Desk, the Chime-Shrine's upgrades or an apothecary's
## mending, and the four portal aprons wait in the rim crags. Wading the
## river's ford splashes; walking into a new petal names it.
## The scene is generated by tools/build_oakshire_vale.gd.
class_name OakshireVale
extends LevelBase

const TITLE: String = "Oakshire Vale"
const QUEST_COLOR: Color = Color(1.0, 0.82, 0.25)
const REGION_COLOR: Color = Color(0.86, 0.94, 0.7)
const QUEST_BANNER_TIME: float = 6.0
const REGION_BANNER_TIME: float = 3.0
## A splash every this many seconds while wading (and moving).
const WADE_EVERY: float = 0.42
const WADE_SPEED: float = 1.0
## Falling faster than this with no ground streamed in under you: load it now.
const CATCH_FALL_SPEED: float = -4.0
## A hub you walk into becomes where you get back up, this far from its middle.
const RESPAWN_SPREAD: float = 2.5
## What each petal holds, for its banner (its kin of the First-Quiet and its delve).
const PETAL_LINES: Array[String] = ["Bramble-Hobs choke the thickets; Tangle-Root-Hollow waits under the petrified oak",
	"Furrow Iron-Men march the quarry terraces; Iron-Kettle-Hollow sleeps in the east crags",
	"The Wayfarers' camp, where every road into the vale begins",
	"Crag-Spriggans guard the standing stones; Star-Barrow-Hollow lies behind them",
	"Curious Bristle-Hobs nose round the orchard; Flagstone-Hollow is under it"]

@onready var grid_manager: WorldGridManager = $World

var world_state: WorldStateDB
var layout: OakshireValeLayout
var spawners: Array[MobSpawner] = []
var townsfolk: Array[TownsfolkNPC] = []
var aprons: Array[PortalApron] = []

var _wade_left: Dictionary[StringName, float] = {}
var _regions: Dictionary[StringName, String] = {}


func instance_id() -> StringName:
	return InstanceManager.OAKSHIRE_VALE


func level_title() -> String:
	return TITLE


func home_place() -> String:
	return "Wayfarer-Green"


func level_hint() -> String:
	return "%s · trail Level %d · follow the lantern-lit roads · talk to anyone under a gold ! · the four portals wait in the rim crags\n%s" % [
		TITLE, PartyProgress.current.trail_level(), HubTown.CHANGE_KEYS]


## Companions fill whichever trinity seats nobody is playing.
func wants_companions() -> bool:
	return true


func _setup_level() -> void:
	layout = WorldGridConfig.layout as OakshireValeLayout
	world_state = WorldStateDB.new()
	add_child(world_state)
	grid_manager.world_state = world_state
	grid_manager.entity_attached.connect(_on_entity_attached)
	grid_manager.entity_detached.connect(_on_entity_detached)
	grid_manager.attach_badge($Screens)
	if OS.get_cmdline_user_args().has("--telemetry"):
		grid_manager.set_telemetry_visible(true)
	var spawns: Array[Vector3] = []
	for marker: Node in spawn_points.get_children():
		spawns.append((marker as Node3D).global_position)
	grid_manager.prime(spawns)


func _process(delta: float) -> void:
	super._process(delta)
	if _key_pressed(KEY_F4):
		grid_manager.set_telemetry_visible(not grid_manager.is_telemetry_visible())


func _physics_process(delta: float) -> void:
	if layout == null:
		return
	for actor: ActorBase in actors.values():
		if not actor.is_local_player():
			continue
		_catch_fall(actor)
		_wade(actor, delta)
		_name_region(actor)


## A respawn or a jump into a chunk whose ground hasn't streamed in yet loads
## it at once (like a loading screen), rather than letting you fall through.
func _catch_fall(actor: ActorBase) -> void:
	if actor.is_on_floor() or actor.velocity.y > CATCH_FALL_SPEED or grid_manager.has_ground_at(actor.global_position):
		return
	grid_manager.prime([actor.global_position])


## The river's ford: wet footsteps while you wade (it never slows you).
func _wade(actor: ActorBase, delta: float) -> void:
	var left: float = _wade_left.get(actor.player_id, 0.0) - delta
	var moving: bool = Vector2(actor.velocity.x, actor.velocity.z).length() > WADE_SPEED
	if moving and layout.water_depth(actor.global_position.x, actor.global_position.z) > 0.05:
		if left <= 0.0:
			left = WADE_EVERY
			AudioCues.play(&"wade", randf_range(0.9, 1.15), -8.0)
	_wade_left[actor.player_id] = left


## Walking into a new part of the vale names it on that player's screen.
func _name_region(actor: ActorBase) -> void:
	var region: String = region_at(actor.global_position)
	if _regions.get(actor.player_id, "") == region:
		return
	var first: bool = not _regions.has(actor.player_id)
	_regions[actor.player_id] = region
	_move_respawn(actor, region)
	var hud: PlayerHUD = huds.get(actor.player_id) as PlayerHUD
	if hud == null:
		return
	hud.enter_place(region, not first)
	if first:
		return
	var petal: int = OakshireValeLayout.PETAL_NAMES.find(region)
	hud.show_banner(region.to_upper(), PETAL_LINES[petal] if petal >= 0 else "", REGION_COLOR, REGION_BANNER_TIME)


## Walking into the village or a petal's camp makes it where you get back up when downed.
func _move_respawn(actor: ActorBase, region: String) -> void:
	var hub: Vector3
	if region == "Oakshire-Wick":
		hub = Vector3(OakshireValeLayout.CENTER.x, OakshireValeLayout.VILLAGE_HEIGHT, OakshireValeLayout.CENTER.y + 10.0)
	else:
		var petal: int = OakshireValeLayout.PETAL_NAMES.find(region)
		if petal < 0 or actor.global_position.distance_to(layout.camp_center(petal)) > 60.0:
			return
		hub = layout.camp_center(petal)
	var column: float = float(actor.party_slot % 4) - 1.5
	actor.spawn_transform = Transform3D(Basis.IDENTITY, hub + Vector3(column * RESPAWN_SPREAD, 0.1, 0.0))


## The part of the vale a spot is in: the village, the meadow round it, or one of the five petals.
func region_at(at: Vector3) -> String:
	var offset: Vector2 = Vector2(at.x, at.z) - OakshireValeLayout.CENTER
	if offset.length() < OakshireValeLayout.VILLAGE_RADIUS + 14.0:
		return "Oakshire-Wick"
	if OakshireValeLayout.ring_distance(offset) < OakshireValeLayout.MEADOW_OUTER - 30.0:
		return "The Settled Meadow"
	var theta: float = rad_to_deg(OakshireValeLayout.bearing(offset))
	var best: int = 0
	for petal: int in OakshireValeLayout.PETAL_BEARINGS.size():
		if absf(angle_difference(deg_to_rad(theta), deg_to_rad(OakshireValeLayout.PETAL_BEARINGS[petal]))) \
				< absf(angle_difference(deg_to_rad(theta), deg_to_rad(OakshireValeLayout.PETAL_BEARINGS[best]))):
			best = petal
	return OakshireValeLayout.PETAL_NAMES[best]


# --- Landblock entities ---------------------------------------------------------

func _on_entity_attached(entity: Node, _chunk: Vector2i) -> void:
	if entity is MobSpawner:
		var spawner: MobSpawner = entity as MobSpawner
		spawners.append(spawner)
		spawner.spawn_mobs()
	elif entity is TownsfolkNPC:
		var npc: TownsfolkNPC = entity as TownsfolkNPC
		townsfolk.append(npc)
		npc.quests_offered.connect(_on_quests_offered)
		npc.wares_requested.connect(_on_wares_requested)
	elif entity is PortalApron:
		aprons.append(entity as PortalApron)


func _on_entity_detached(entity: Node, _chunk: Vector2i) -> void:
	if entity is MobSpawner:
		spawners.erase(entity)
	elif entity is TownsfolkNPC:
		townsfolk.erase(entity)
	elif entity is PortalApron:
		aprons.erase(entity)


## A quest giver's three quests on the asker's screen (the quest log itself isn't built yet).
func _on_quests_offered(actor: ActorBase, npc: TownsfolkNPC) -> void:
	var hud: PlayerHUD = huds.get(actor.player_id) as PlayerHUD
	if hud != null:
		hud.show_banner("%s of %s" % [npc.npc_name, npc.hub], "Quests: " + "  ·  ".join(npc.quests), QUEST_COLOR, QUEST_BANNER_TIME)


## A vendor's wares: the Armory & Scribe Desk at the right row, the Chime-Vault's upgrades, or an apothecary's mending.
func _on_wares_requested(actor: ActorBase, npc: TownsfolkNPC) -> void:
	var hud: PlayerHUD = huds.get(actor.player_id) as PlayerHUD
	match npc.wares:
		TownsfolkNPC.Wares.WEAPONS:
			if hud != null:
				hud.open_scribe_desk(ScribeDeskMenu.ROW_WEAPON)
		TownsfolkNPC.Wares.ARMOR:
			if hud != null:
				hud.open_scribe_desk(ScribeDeskMenu.ROW_ARMOR)
		TownsfolkNPC.Wares.CALLING_TUTOR:
			if hud != null:
				hud.open_scribe_desk(ScribeDeskMenu.ROW_CALLING)
		TownsfolkNPC.Wares.BANKER:
			if hud != null:
				hud.open_upgrade_menu()
		TownsfolkNPC.Wares.APOTHECARY:
			CombatDirector.current.apply_heal(actor, actor, actor.stats.stats.max_health)
			CombatDirector.current.reward(actor, 0.0, actor.stats.stats.max_stamina)
			CombatDirector.current.announce(actor.global_position + Vector3.UP * 2.6, "%s's tonic: mended" % npc.npc_name, Color(0.5, 1.0, 0.6), &"heal")


func _report_extra() -> String:
	var metrics: Dictionary = grid_manager.get_streaming_metrics()
	return " · Oakshire: %d spawners, %d townsfolk, %d aprons in range · %s" % [spawners.size(), townsfolk.size(), aprons.size(),
		WorldTelemetryBadge.text_for(metrics)]
